# ── Supabase ──────────────────────────────────────────────
# Local dev (supabase start гүйцэтгэсний дараа CLI хэвлэнэ):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Зөвхөн серверт (Edge Function / Server Action) — браузерт хэзээ ч бүү ил гарга:
SUPABASE_SERVICE_ROLE_KEY=

# ── AI үнэлгээ (Phase 9) ──────────────────────────────────
ANTHROPIC_API_KEY=
# эсвэл OPENAI_API_KEY=

# ── Төлбөр: QPay (Phase 10) ───────────────────────────────
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# ── Газрын зураг (Phase 11) ───────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Resend (имэйл — агент урих, мэдэгдэл) ─────────────────
# RESEND_FROM нь resend.com/domains-д VERIFY хийсэн домэйнтэй байх ёстой
# (nemi.mn verified). Баталгаажаагүй домэйн/onboarding@resend.dev нь зөвхөн
# Resend эзний имэйл рүү илгээдэг тул бодит агентуудад очихгүй.
RESEND_API_KEY=
RESEND_FROM=Нэми <noreply@nemi.mn>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OAuth (Supabase dashboard-д тохируулна, эндээс лавлагаа) ─
# Google / Facebook client id, secret-ийг Supabase Auth тохиргоонд оруулна.

# Google Maps (console.cloud.google.com → Maps JavaScript API + Map ID)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# CRM cron (Vercel cron ба Supabase Vault-ийн crm_cron_secret-тэй ЯГ ижил утга)
CRON_SECRET=

# CRM push мэдэгдэл (npx web-push generate-vapid-keys). Public түлхүүр хоёуланд ижил.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# CRM гадны маягтын intake (/api/crm/intake). Хоосон бол хаалттай (503).
CRM_INTAKE_SECRET=

# Нийтийн холбоос/QR-ын HMAC давс (сонголттой)
CRM_PUBLIC_LINK_SALT=

# ── SEO (сонголттой, нийтийн утга; build үед уншина — өөрчилбөл redeploy) ──
# fb:app_id meta (Facebook share insights). Хоосон бол tag гарахгүй.
FB_APP_ID=
# Search Console HTML-tag баталгаажуулалт. Хоосон бол tag гарахгүй (DNS-ээр ч болно).
GOOGLE_SITE_VERIFICATION=

# ── Утсаар нэвтрэх (R09 Stage 2) — хоосон бол унтраастай ──
# 1 = /login дээр «Утсаар» таб харуулна. Build үед inline — өөрчилбөл redeploy.
# End-to-end тест амжилттай болтол ХООСОН үлдээ.
NEXT_PUBLIC_PHONE_LOGIN=
# Supabase Dashboard → Authentication → Hooks → Send SMS hook-ийн нууц (v1,whsec_...).
# Серверт л. Мөн SUPABASE_SERVICE_ROLE_KEY (дээр) заавал хэрэгтэй (дугаар тутмын тоолуур).
SUPABASE_SMS_HOOK_SECRET=
# http (анхдагч) | console (зөвхөн локал dev; production-д ажиллахгүй)
SMS_PROVIDER=
# SMS gateway (JSON POST {from,to,text}, Bearer token). Production-д https заавал.
SMS_API_URL=
SMS_API_TOKEN=
# Илгээгчийн нэр/дугаар (анхдагч Nemi)
SMS_SENDER=
# Сонголттой: {code} заавал, {host} сонголттой. Gateway UCS-2 (кирилл) дэмжихгүй бол латин бичвэр.
SMS_OTP_TEMPLATE=
# Нэг дугаарт 24 цагт илгээх SMS-ийн дээд тоо (анхдагч 5)
PHONE_OTP_MAX_PER_DAY=

# ── Facebook хуудсанд шууд нийтлэх (R10, сонголттой) ──
# FB_PAGE_ID эсвэл FB_PAGE_ACCESS_TOKEN хоосон бол «Оффисын хуудсанд нийтлэх» товч
# хаана ч гарахгүй (хуулж тавих «Түгээх» хэрэгсэл хэвээр ажиллана).
# Оффисын Facebook хуудасны тоон ID
FB_PAGE_ID=
# Серверт л: pages_manage_posts эрхтэй урт хугацааны Page token. Хэзээ ч NEXT_PUBLIC_ бүү болго.
FB_PAGE_ACCESS_TOKEN=
# Graph API хувилбар (анхдагч v26.0). Шинэ хувилбарыг эндээс шалгаж шинэчилнэ:
# https://developers.facebook.com/docs/graph-api/changelog/versions
FB_GRAPH_VERSION=
# offices.id — энэ оффисын office_admin (panel_admin) нийтэлж болно. Хоосон = зөвхөн платформын админ.
FB_PAGE_OFFICE_ID=
# Зарын үзэлтийн нэргүй статистик (/api/listing-view) нь дээрх SUPABASE_SERVICE_ROLE_KEY-г
# ашиглана; хоосон бол чимээгүй унтраастай.

# ── Ухаалаг хайлтын AI (R08c Stage 3, сонголттой) — дутуу бол унтраастай ──
# Дээрх ANTHROPIC_API_KEY + SUPABASE_SERVICE_ROLE_KEY + доорх RATE_LIMIT_SALT (≥32 тэмдэгт)
# бүгд байвал /listings дээр «AI-аар ойлгуулах» товч гарна (migration 20261123000700 хэрэгтэй).
# off = ANTHROPIC_API_KEY байгаа үед ухаалаг хайлтын AI-г унтраах
AI_SEARCH=
# Өдөрт (UTC) кэшгүй AI дуудлагын нийт дээд тоо (анхдагч 500)
AI_SEARCH_DAILY_CAP=
# Серверт л: IP хэшлэх давс (санамсаргүй, 32+ тэмдэгт). Хэзээ ч commit бүү хий.
RATE_LIMIT_SALT=
