# ── Supabase ──────────────────────────────────────────────
# Local dev (supabase start гүйцэтгэсний дараа CLI хэвлэнэ):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Зөвхөн серверт (Edge Function / Server Action) — браузерт хэзээ ч бүү ил гарга:
SUPABASE_SERVICE_ROLE_KEY=

# ── AI үнэлгээ (Phase 9) ──────────────────────────────────
ANTHROPIC_API_KEY=
# эсвэл OPENAI_API_KEY=

# ── Төлбөр: QPay (Phase 10) ───────────────────────────────
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# ── Газрын зураг (Phase 11) ───────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Resend (имэйл — агент урих, мэдэгдэл) ─────────────────
# RESEND_FROM нь resend.com/domains-д VERIFY хийсэн домэйнтэй байх ёстой
# (nemi.mn verified). Баталгаажаагүй домэйн/onboarding@resend.dev нь зөвхөн
# Resend эзний имэйл рүү илгээдэг тул бодит агентуудад очихгүй.
RESEND_API_KEY=
RESEND_FROM=Нэми <noreply@nemi.mn>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OAuth (Supabase dashboard-д тохируулна, эндээс лавлагаа) ─
# Google / Facebook client id, secret-ийг Supabase Auth тохиргоонд оруулна.

# Google Maps (console.cloud.google.com → Maps JavaScript API + Map ID)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# CRM cron (Vercel cron ба Supabase Vault-ийн crm_cron_secret-тэй ЯГ ижил утга)
CRON_SECRET=

# CRM push мэдэгдэл (npx web-push generate-vapid-keys). Public түлхүүр хоёуланд ижил.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# CRM гадны маягтын intake (/api/crm/intake). Хоосон бол хаалттай (503).
CRM_INTAKE_SECRET=

# Нийтийн холбоос/QR-ын HMAC давс (сонголттой)
CRM_PUBLIC_LINK_SALT=
