{
  "framework": "nextjs",
  "buildCommand": "next build",
  "crons": [
    {
      "path": "/api/cron/search-alerts?key=",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/crm-sla",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/crm-matching",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/crm-daily",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/crm-monthly",
      "schedule": "0 0 1 * *"
    }
  ]
}
